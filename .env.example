# ==============================================================================
# NEXUS AI — Variables d'environnement frontend (Vite)
# Ne JAMAIS placer de clé secrète (ex: service_role, clé API LLM brute) ici.
# Toutes les variables VITE_* sont visibles publiquement dans le navigateur.
# ==============================================================================

# 1. URL du backend proxy LLM (optionnel, pour activer l'IA réelle en production)
# Si vide en développement local, le dev server proxy intégré (/api/ai/*) est utilisé.
VITE_API_BASE_URL=

# 2. Configuration Supabase (pour authentification réelle et synchronisation cloud)
# Obtenez ces valeurs sur votre tableau de bord Supabase : Project Settings > API
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_publique_anon_ici

# ==============================================================================
# VARIABLES SERVEUR PROXY / SUPABASE SECRETS (CÔTÉ SERVEUR UNIQUEMENT)
# Ne pas préfixer par VITE_. Ces variables résident uniquement sur votre serveur,
# dans votre gestionnaire de secrets ou dans Supabase Secrets (supabase secrets set).
# ==============================================================================
# GEMINI_API_KEY=votre_cle_google_gemini
# OPENAI_API_KEY=votre_cle_openai
# ANTHROPIC_API_KEY=votre_cle_anthropic
# MISTRAL_API_KEY=votre_cle_mistral
# GROQ_API_KEY=votre_cle_groq

